# PostgreSQL (development)
DATABASE_URL=postgres://app:app@localhost:5432/app_dev
# PostgreSQL (integration tests) — the test suite truncates this database
TEST_DATABASE_URL=postgres://app:app@localhost:5432/app_test
# Base URL used in invitation links
APP_BASE_URL=http://localhost:3000
# 32+ random bytes, base64. Encrypts TOTP secrets, phone numbers and health free text at rest.
APP_ENCRYPTION_KEY=
# Key rotation: previous keys (comma-separated, base64), still accepted for reading until
# `pnpm keys:rotate` has re-encrypted every column with the current key.
APP_ENCRYPTION_KEYS_PREVIOUS=
# on = reject passwords found in known breaches (Have I Been Pwned range API, k-anonymity:
# only the first 5 hex chars of the SHA-1 leave the server; fails open if unreachable).
PWNED_PASSWORDS_CHECK=off

# Local file storage for uploaded images (silhouettes)
FILE_STORAGE_DIR=

# Observability (Phase 15): debug | info | warn | error. Optional collector for scrubbed errors.
LOG_LEVEL=info
ERROR_WEBHOOK_URL=
APP_VERSION=
# Per-user API budgets per minute (defaults 1000 reads, 120 writes, 30 heavy operations).
API_LIMIT_READ=
API_LIMIT_WRITE=
API_LIMIT_HEAVY=
# Object storage for uploaded files (S3-compatible bucket in the EU). When S3_BUCKET is empty,
# files go to FILE_STORAGE_DIR (local disk / shared volume).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional server-side encryption header (e.g. AES256) if the provider supports it.
S3_SSE=
