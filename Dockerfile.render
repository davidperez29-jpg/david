# Image for Render (render.yaml, docs/DEPLOY_RENDER.md). Same as the `platform` stage of
# ./Dockerfile, without BuildKit-only syntax so any Docker builder can build it.
FROM node:22-bookworm-slim AS build
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH NEXT_TELEMETRY_DISABLED=1
RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile && NEXT_OUTPUT=standalone pnpm build \
 && cp -r apps/web/.next/static apps/web/.next/standalone/apps/web/.next/static \
 && cp -r apps/web/public apps/web/.next/standalone/apps/web/public

FROM node:22-bookworm-slim
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000 NEXT_TELEMETRY_DISABLED=1 \
    FILE_STORAGE_DIR=/data/files
COPY --from=build --chown=node:node /app /app
RUN mkdir -p /data/files && chown node:node /data/files
USER node
EXPOSE 3000
CMD ["sh", "/app/deploy/start.sh"]
