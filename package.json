{
  "name": "training-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @tp/web dev",
    "build": "pnpm --filter @tp/web build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "contract:update": "node scripts/contract-update.mjs",
    "contract:responses": "CONTRACT_UPDATE=1 pnpm --filter @tp/web exec playwright test e2e/contract-responses.spec.ts",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "test:e2e": "pnpm --filter @tp/web test:e2e",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "db:generate": "pnpm --filter @tp/db generate",
    "db:migrate": "pnpm --filter @tp/db migrate",
    "db:seed": "pnpm --filter @tp/db seed",
    "db:seed:demo": "pnpm --filter @tp/application seed:demo",
    "db:seed:perf": "pnpm --filter @tp/application seed:perf",
    "monitor:daily": "pnpm --filter @tp/application monitor:daily",
    "db:reset": "pnpm --filter @tp/db reset",
    "privacy:daily": "pnpm --filter @tp/application privacy:daily",
    "keys:rotate": "pnpm --filter @tp/application keys:rotate",
    "injuries:encrypt-text": "pnpm --filter @tp/application injuries:encrypt-text",
    "privacy:reapply-erasures": "pnpm --filter @tp/application privacy:reapply-erasures"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "^18.5.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
